<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>My Music</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      height: 100vh;
      overflow: hidden;
      background: #111;
      font-family: Arial, sans-serif;
    }

    .blob {
      position: absolute;
      width: 100px;
      height: 100px;
      border-radius: 50%;

      display: flex;
      align-items: center;
      justify-content: center;

      color: white;
      font-size: 14px;
      text-align: center;

      cursor: pointer;

      transition:
        transform 0.3s ease,
        filter 0.3s ease;

      animation: float 8s ease-in-out infinite;
    }

    .blob:hover {
      transform: scale(1.5);
      filter: brightness(1.3);
      z-index: 10;
    }

    .blob1 {
      background: #ff4d6d;
      left: 20%;
      top: 25%;
    }

    .blob2 {
      background: #7b61ff;
      left: 50%;
      top: 20%;
      animation-delay: -2s;
    }

    .blob3 {
      background: #35c9a5;
      left: 70%;
      top: 55%;
      animation-delay: -4s;
    }

    .blob4 {
      background: #ffb84d;
      left: 35%;
      top: 65%;
      animation-delay: -6s;
    }

    @keyframes float {
      0%, 100% {
        transform: translate(0, 0);
      }

      50% {
        transform: translate(30px, -25px);
      }
    }
  </style>
</head>

<body>

  <div class="blob blob1" onclick="playSong('song1.mp3')">
    Song One
  </div>

  <div class="blob blob2" onclick="playSong('song2.mp3')">
    Song Two
  </div>

  <div class="blob blob3" onclick="playSong('song3.mp3')">
    Song Three
  </div>

  <div class="blob blob4" onclick="playSong('song4.mp3')">
    Song Four
  </div>

  <script>
    function playSong(song) {
      console.log("Playing:", song);

      // Later we'll put the actual music player here
    }
  </script>

</body>
</html>
